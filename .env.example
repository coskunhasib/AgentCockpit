TELEGRAM_TOKEN=BURAYA_BOTFATHER_TOKEN_YAZ
ALLOWED_USER_ID=
TELEGRAM_BOT_USERNAME=
# TELEGRAM_TOKEN bos/placeholder ise ilk acilista local tarayici kurulum sayfasi token'i sorar.
# Botu ilk calistirdiginda sana mesaj at, otomatik kaydedileceksin.

PHONE_BIND=0.0.0.0
PHONE_PORT=8765
PHONE_CONTROL_PORT=18765
PHONE_ADMIN_TOKEN=
PHONE_SESSION_MINUTES=0
PHONE_POLL_MS=1400
PHONE_TELEGRAM_URL=
PHONE_SCREENSHOT_QUALITY=55
PHONE_SCREENSHOT_MAX_WIDTH=1600
PHONE_PUBLIC_TUNNEL=auto
PHONE_PUBLIC_TUNNEL_DOWNLOAD=1
PHONE_PUBLIC_TUNNEL_WAIT_SEC=8
PHONE_PUBLIC_TUNNEL_MAX_RESTARTS=5
PHONE_PUBLIC_TUNNEL_RESTART_DELAY_SEC=3
PHONE_PUBLIC_TUNNEL_RESTART_MAX_DELAY_SEC=60
PHONE_PUBLIC_TUNNEL_VALIDATE_CACHE_SEC=8
PHONE_PUBLIC_TUNNEL_VALIDATE_GRACE_SEC=120
PHONE_PUBLIC_TUNNEL_VALIDATE_FAILURES_BEFORE_RESTART=3
# Tunel bu kadar saniye saglikli kalirsa yeniden baslatma butcesi sifirlanir.
PHONE_PUBLIC_TUNNEL_RESTART_RESET_SEC=600
# Restart limiti dolunca kalici pes etmek yerine bu kadar saniye soguyup tekrar dener.
PHONE_PUBLIC_TUNNEL_LIMIT_COOLOFF_SEC=300
# Sabit hostname icin Cloudflare named tunnel (Zero Trust panelinden token al,
# ingress'i http://127.0.0.1:18765 olarak esle). Bos birakilirsa Quick Tunnel kullanilir.
PHONE_CLOUDFLARE_TUNNEL_TOKEN=
PHONE_CLOUDFLARE_TUNNEL_HOSTNAME=
# Varsayilan WAN Cloudflare'dir. IP/Bore fallback sadece bilerek acilirsa kullanilir.
PHONE_PUBLIC_TUNNEL_FALLBACK=off
PHONE_PUBLIC_TUNNEL_FALLBACK_DELAY_SEC=20
PHONE_BORE_SERVER=159.223.110.159
PHONE_BORE_PUBLIC_HOST=159.223.110.159
PHONE_BORE_REMOTE_PORT=
PHONE_BORE_RESTART_DELAY_SEC=3
PHONE_BORE_RESTART_MAX_DELAY_SEC=60
PHONE_KEEP_AWAKE=1
PHONE_KEEP_AWAKE_FLAGS=-dims
PHONE_CAPTURE_LOCK_TIMEOUT_SEC=3.0
# Anlik RSS bu esigi asarsa ekran yakalama sistemi korumak icin gecici durur (0=kapali).
PHONE_CAPTURE_MAX_RSS_MB=512
PHONE_DRAG_STEP_PIXELS=16
PHONE_DRAG_STEP_DELAY_MS=4
PHONE_STREAM_MAX_CONNECTIONS=2
PHONE_STREAM_MAX_SECONDS=600
PHONE_STREAM_GC_EVERY_FRAMES=120
# Sinirsiz link/cihaz state'inin RAM ve disk uzerinde buyumesini sinirlar.
PHONE_SESSION_LINK_MAX_ENTRIES=256
PHONE_TRUSTED_DEVICE_MAX_ENTRIES=64
PHONE_TRUSTED_DEVICE_STALE_DAYS=90
# last_seen dosyaya en fazla bu aralikla yazilir.
PHONE_TRUSTED_DEVICE_PERSIST_SEC=300
# PID-bazli log/diagnostic dosyalari ve launchd stderr sinirlari.
AGENTCOCKPIT_LOG_RETENTION_DAYS=7
AGENTCOCKPIT_LOG_MAX_FILES_PER_GROUP=128
AGENTCOCKPIT_STDIO_LOG_MAX_MB=10
AGENTCOCKPIT_LOG_MAINTENANCE_INTERVAL_SEC=3600
# macOS cloudflared DNS/TLS dalgalanmasinda auto, 1 veya 0 kullanilabilir.
CLOUDFLARED_FORCE_GO_DNS=auto
